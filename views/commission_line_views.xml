<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_line_list" model="ir.ui.view">
        <field name="name">yaguven.commission.line.list</field>
        <field name="model">yaguven.commission.line</field>
        <field name="arch" type="xml">
            <list default_order="invoice_date desc, id" create="false">
                <field name="salesperson_id"/>
                <field name="move_name"/>
                <field name="source_type" widget="badge"
                       decoration-warning="source_type == 'pos_order'"/>
                <field name="invoice_date"/>
                <field name="volume" widget="monetary" sum="Volume"/>
                <field name="cost_total" widget="monetary" sum="Cost"/>
                <field name="margin" widget="monetary" sum="Margin"/>
                <field name="pct_applied"/>
                <field name="commission_amount" widget="monetary" sum="Earned"/>
                <field name="is_collected" widget="boolean_toggle"/>
                <field name="commission_payable" widget="monetary" sum="Payable"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_commission_line_form" model="ir.ui.view">
        <field name="name">yaguven.commission.line.form</field>
        <field name="model">yaguven.commission.line</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group string="Source">
                            <field name="target_id"/>
                            <field name="salesperson_id"/>
                            <field name="source_type"/>
                            <field name="move_id" invisible="source_type != 'invoice'"/>
                            <field name="pos_order_id" invisible="source_type != 'pos_order'"/>
                            <field name="invoice_date"/>
                            <field name="move_type" invisible="source_type != 'invoice'"/>
                        </group>
                        <group string="Calculation">
                            <field name="volume" widget="monetary"/>
                            <field name="cost_total" widget="monetary"/>
                            <field name="margin" widget="monetary"/>
                            <field name="pct_applied"/>
                            <field name="commission_amount" widget="monetary"/>
                            <field name="is_collected"/>
                            <field name="commission_payable" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_line_search" model="ir.ui.view">
        <field name="name">yaguven.commission.line.search</field>
        <field name="model">yaguven.commission.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="salesperson_id"/>
                <field name="move_name" string="Document"/>
                <filter name="filter_invoice" string="Invoice"
                        domain="[('source_type', '=', 'invoice')]"/>
                <filter name="filter_pos_order" string="POS Order (not invoiced)"
                        domain="[('source_type', '=', 'pos_order')]"/>
                <separator/>
                <filter name="filter_collected" string="Collected"
                        domain="[('is_collected', '=', True)]"/>
                <filter name="filter_not_collected" string="Not Collected"
                        domain="[('is_collected', '=', False)]"/>
                <group>
                    <filter name="groupby_salesperson" string="Salesperson"
                            context="{'group_by': 'salesperson_id'}"/>
                    <filter name="groupby_source" string="Source"
                            context="{'group_by': 'source_type'}"/>
                    <filter name="groupby_collected" string="Collection"
                            context="{'group_by': 'is_collected'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_line" model="ir.actions.act_window">
        <field name="name">Commission Lines</field>
        <field name="res_model">yaguven.commission.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_line_search"/>
    </record>

</odoo>
