<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_target_list" model="ir.ui.view">
        <field name="name">yaguven.commission.target.list</field>
        <field name="model">yaguven.commission.target</field>
        <field name="arch" type="xml">
            <list default_order="year desc, month desc, salesperson_id">
                <field name="salesperson_id"/>
                <field name="year" options="{'enable_formatting': false}"/>
                <field name="month"/>
                <field name="objective_usd" widget="monetary"/>
                <field name="volume_total" widget="monetary" sum="Volume"/>
                <field name="tier"
                       decoration-muted="tier == 'below'"
                       decoration-info="tier == 'target'"
                       decoration-success="tier == 'super'"
                       widget="badge"/>
                <field name="pct"/>
                <field name="margin_total" widget="monetary" sum="Margin"/>
                <field name="commission_earned" widget="monetary" sum="Earned"/>
                <field name="commission_collected" widget="monetary" sum="Collected"/>
                <field name="commission_pending" widget="monetary" sum="Pending"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_commission_target_form" model="ir.ui.view">
        <field name="name">yaguven.commission.target.form</field>
        <field name="model">yaguven.commission.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recompute" type="object"
                            string="Recompute" class="oe_highlight"/>
                    <field name="last_recompute" widget="datetime" readonly="1"
                           nolabel="1" class="oe_inline ms-2"/>
                    <button name="action_print_report" type="object"
                            string="Print Report"/>
                    <button name="action_create_purchase_order" type="object"
                            string="Create Purchase Order"
                            invisible="purchase_order_id"
                            confirm="Create a Purchase Order against the salesperson for the Commission Collected amount?"/>
                    <button name="action_create_purchase_order" type="object"
                            string="View Purchase Order"
                            invisible="not purchase_order_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Input (Janel)">
                            <field name="salesperson_id" options="{'no_create_edit': True}"/>
                            <field name="year" options="{'enable_formatting': false}"/>
                            <field name="month"/>
                            <field name="objective_usd" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="config_id" groups="base.group_no_one"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Month Result">
                            <field name="volume_total" widget="monetary" readonly="1"/>
                            <field name="tier" widget="badge" readonly="1"
                                   decoration-muted="tier == 'below'"
                                   decoration-info="tier == 'target'"
                                   decoration-success="tier == 'super'"/>
                            <field name="pct" readonly="1"/>
                            <field name="margin_total" widget="monetary" readonly="1"/>
                            <field name="commission_earned" widget="monetary" readonly="1"/>
                            <field name="commission_collected" widget="monetary" readonly="1"/>
                            <field name="commission_pending" widget="monetary" readonly="1"/>
                            <field name="purchase_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail by Sale" name="lines">
                            <field name="line_ids" readonly="1">
                                <list default_order="invoice_date, id">
                                    <field name="move_name" string="Document"/>
                                    <field name="source_type" widget="badge"
                                           decoration-warning="source_type == 'pos_order'"/>
                                    <field name="invoice_date"/>
                                    <field name="move_type" optional="hide"/>
                                    <field name="volume" widget="monetary" sum="Volume"/>
                                    <field name="cost_total" widget="monetary" sum="Cost"/>
                                    <field name="margin" widget="monetary" sum="Margin"/>
                                    <field name="pct_applied"/>
                                    <field name="commission_amount" widget="monetary" sum="Earned"/>
                                    <field name="is_collected" widget="boolean_toggle"/>
                                    <field name="commission_payable" widget="monetary" sum="Payable"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commission_target_search" model="ir.ui.view">
        <field name="name">yaguven.commission.target.search</field>
        <field name="model">yaguven.commission.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="salesperson_id"/>
                <field name="year"/>
                <filter name="filter_mine" string="Mine"
                        domain="[('salesperson_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_below" string="Below Goal"
                        domain="[('tier', '=', 'below')]"/>
                <filter name="filter_target" string="At Goal"
                        domain="[('tier', '=', 'target')]"/>
                <filter name="filter_super" string="Above Goal"
                        domain="[('tier', '=', 'super')]"/>
                <separator/>
                <filter name="filter_pending" string="With Pending Collection"
                        domain="[('commission_pending', '&gt;', 0)]"/>
                <group>
                    <filter name="groupby_salesperson" string="Salesperson"
                            context="{'group_by': 'salesperson_id'}"/>
                    <filter name="groupby_year" string="Year"
                            context="{'group_by': 'year'}"/>
                    <filter name="groupby_month" string="Month"
                            context="{'group_by': 'month'}"/>
                    <filter name="groupby_tier" string="Tier"
                            context="{'group_by': 'tier'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_target" model="ir.actions.act_window">
        <field name="name">Goals &amp; Commissions</field>
        <field name="res_model">yaguven.commission.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_target_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set the first monthly goal.</p>
            <p>Pick a salesperson, a month and a volume goal. The commission works
               itself out from that salesperson's invoices for the month.</p>
        </field>
    </record>

</odoo>
